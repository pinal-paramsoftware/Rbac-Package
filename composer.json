{
    "name": "pinal-paramsoftware/laravel-rbac-suite",
    "description": "Enterprise-grade Role-Based Access Control (RBAC) and Multi-Layer Authentication Pipeline for Laravel applications.",
    "keywords": [
        "laravel",
        "rbac",
        "roles",
        "permissions",
        "authentication",
        "two-factor",
        "otp",
        "device-authorization"
    ],
    "homepage": "https://github.com/pinal-paramsoftware/Rbac-Package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Pinal",
            "homepage": "https://github.com/pinal-paramsoftware"
        },
        {
            "name": "Parth",
            "email": "parth@example.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/pinal-paramsoftware/Rbac-Package/issues",
        "source": "https://github.com/pinal-paramsoftware/Rbac-Package"
    },
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0",
        "bacon/bacon-qr-code": "^2.0 || ^3.0",
        "laravel/ui": "^4.0",
        "pragmarx/google2fa-laravel": "^2.0 || ^3.0",
        "spatie/laravel-permission": "^6.0",
        "yajra/laravel-datatables-oracle": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Parth\\LaravelRbacSuite\\": "src/",
            "Parth\\LaravelRbacSuite\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Parth\\LaravelRbacSuite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Parth\\LaravelRbacSuite\\RbacSuiteServiceProvider"
            ],
            "aliases": {
                "RbacSuite": "Parth\\LaravelRbacSuite\\Facades\\RbacSuite"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
